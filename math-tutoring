<style>
  :root {
    --paper: #faf8f3;
    --grid-line: #dcdfe6;
    --ink: #26282e;
    --ink-soft: #565c66;
    --pencil-blue: #33479b;
    --highlight: #ffcf3f;
    --navy: #1b2340;
    --paper-card: #ffffff;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background:
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 100% 32px,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 32px 100%,
      var(--paper);
    background-attachment: local;
    color: var(--ink);
    font-family: "Inter", -apple-system, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
  }

  a { color: var(--pencil-blue); }

  h1, h2, h3 {
    font-family: "Fraunces", Georgia, serif;
    color: var(--ink);
    margin: 0 0 0.4em 0;
    font-weight: 500;
  }

  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- Nav ---------- */
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(250, 248, 243, 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--grid-line);
  }
  nav .wrap {
    max-width: 900px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
  }
  .nav-name {
    font-family: "Fraunces", serif;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .nav-links {
    display: flex;
    gap: 24px;
    font-size: 0.95rem;
  }
  .nav-links a { text-decoration: none; color: var(--ink-soft); }
  .nav-links a:hover { color: var(--pencil-blue); }

  /* ---------- Hero ---------- */
  header.hero {
    max-width: 900px;
    margin: 0 auto;
    padding: 64px 24px 40px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 32px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1.15;
  }
  .hero p.lede {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 46ch;
  }
  .hero-actions {
    margin-top: 28px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 3px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.98rem;
    border: 1.5px solid var(--ink);
  }
  .btn-solid {
    background: var(--ink);
    color: var(--paper);
  }
  .btn-solid:hover { background: var(--pencil-blue); border-color: var(--pencil-blue); }
  .btn-outline {
    background: transparent;
    color: var(--ink);
  }
  .btn-outline:hover { border-color: var(--pencil-blue); color: var(--pencil-blue); }

  .hero-figure svg { width: 100%; height: auto; }

  /* ---------- Sections ---------- */
  section {
    max-width: 900px;
    margin: 0 auto;
    padding: 56px 24px;
    border-top: 1px solid var(--grid-line);
  }
  section h2 {
    font-size: 1.6rem;
    margin-bottom: 24px;
  }
  .section-lede {
    color: var(--ink-soft);
    max-width: 60ch;
    margin: -12px 0 28px;
  }

  /* Subjects */
  .subject-group {
    margin-bottom: 30px;
  }
  .subject-group:last-child { margin-bottom: 0; }
  .subject-group h3 {
    font-size: 1.05rem;
    color: var(--pencil-blue);
    margin-bottom: 4px;
  }
  .subject-group .group-note {
    color: var(--ink-soft);
    font-size: 0.88rem;
    margin: 0 0 12px;
  }
  .subject-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px 32px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .subject-list li {
    padding: 9px 0;
    border-bottom: 1px dashed var(--grid-line);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 1rem;
  }
  .subject-list li span.level {
    color: var(--ink-soft);
    font-size: 0.85rem;
    font-family: "Fraunces", serif;
    font-style: italic;
    white-space: nowrap;
  }
  .subjects-source-note {
    color: var(--ink-soft);
    font-size: 0.85rem;
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px dashed var(--grid-line);
  }

  /* About / skills */
  .skills-list {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
  }
  .skills-list li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 10px;
  }
  .skills-list li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--pencil-blue);
  }

  /* How it works — genuinely sequential, numbering earned */
  .steps {
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .step {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    align-items: baseline;
  }
  .step .num {
    counter-increment: step;
    font-family: "Fraunces", serif;
    font-size: 1.3rem;
    color: var(--pencil-blue);
  }
  .step .num::before { content: counter(step); }
  .step h3 { font-size: 1.05rem; margin-bottom: 4px; }
  .step p { margin: 0; color: var(--ink-soft); }

  /* Testimonial */
  .testimonial {
    background: var(--paper-card);
    border: 1px solid var(--grid-line);
    border-left: 3px solid var(--highlight);
    padding: 28px 32px;
    border-radius: 2px;
  }
  .testimonial p.quote {
    font-family: "Fraunces", serif;
    font-size: 1.2rem;
    font-style: italic;
    margin: 0 0 12px;
  }
  .testimonial p.attr {
    color: var(--ink-soft);
    font-size: 0.92rem;
    margin: 0;
  }
  .testimonial-form-wrap {
    margin-top: 32px;
  }
  .testimonial-form-wrap h3 {
    font-size: 1.1rem;
  }

  /* Pricing */
  .rates {
    display: grid;
    gap: 14px;
  }
  .rate-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 14px 18px;
    background: var(--paper-card);
    border: 1px solid var(--grid-line);
    border-radius: 2px;
  }
  .rate-row .amount {
    font-family: "Fraunces", serif;
    font-size: 1.3rem;
    background: linear-gradient(to bottom, transparent 60%, var(--highlight) 60%);
    padding: 0 2px;
  }
  .rates-note {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin-top: 8px;
  }

  /* Contact */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .contact-list { list-style: none; padding: 0; margin: 0; }
  .contact-list li { margin-bottom: 14px; font-size: 1.02rem; }
  .contact-list .label { display: block; color: var(--ink-soft); font-size: 0.85rem; }

  form.contact-form { display: flex; flex-direction: column; gap: 12px; }
  form.contact-form input,
  form.contact-form textarea {
    font-family: inherit;
    font-size: 1rem;
    padding: 11px 12px;
    border: 1px solid var(--grid-line);
    border-radius: 3px;
    background: var(--paper-card);
    color: var(--ink);
  }
  form.contact-form textarea { resize: vertical; min-height: 90px; }
  form.contact-form button {
    align-self: flex-start;
    cursor: pointer;
    font-family: inherit;
  }
  form.contact-form .form-status {
    min-height: 1.2em;
    font-size: 0.9rem;
    margin: 4px 0 0;
  }

  footer {
    max-width: 900px;
    margin: 0 auto;
    padding: 28px 24px 48px;
    color: var(--ink-soft);
    font-size: 0.88rem;
    display: flex;
    justify-content: space-between;
  }

  @media (max-width: 680px) {
    .hero { grid-template-columns: 1fr; padding-top: 40px; }
    .hero-figure { order: -1; max-width: 260px; margin: 0 auto; }
    .subject-list { grid-template-columns: 1fr; }
    .contact-grid { grid-template-columns: 1fr; }
    footer { flex-direction: column; gap: 8px; }
  }

  :focus-visible {
    outline: 2px solid var(--pencil-blue);
    outline-offset: 2px;
  }
</style>
</head>
