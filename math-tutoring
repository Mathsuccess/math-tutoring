      <li>Mathematics for Technology III <span class="level">MTH-3903</span></li>
      <li>Mathematics for Technology IV <span class="level">MTH-4903</span></li>
      <li>Statistics for Technology <span class="level">STA-1903</span></li>
    </ul>
